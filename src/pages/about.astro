---
import Base from '../layouts/Base.astro';
---

<Base title="0xDiyor — About">
  <h2 class="section-title">About</h2>

  <div class="about">
    <div class="cmd">fastfetch</div>
    <div class="fetch">
      <pre class="logo" aria-hidden="true"><span class="dm">┌────────────────┐</span>
<span class="dm">│</span>                <span class="dm">│</span>
<span class="dm">│</span>  <span class="xd">~$</span> whoami     <span class="dm">│</span>
<span class="dm">│</span>  diyor         <span class="dm">│</span>
<span class="dm">│</span>  <span class="xd">~$</span> <span class="cursor">▊</span>          <span class="dm">│</span>
<span class="dm">│</span>                <span class="dm">│</span>
<span class="dm">└───────┬┬───────┘</span>
<span class="dm">     ┌──┴┴──┐</span>
<span class="dm"> ────┴──────┴────</span></pre>
      <dl class="kv">
        <div><dt>role</dt><dd>cybersecurity student &middot; IT professional</dd></div>
        <div><dt>edu</dt><dd>WGU B.S. (Aug 2028)</dd></div>
        <div><dt>certs</dt><dd>CySA+ &middot; Security+ &middot; Network+<br />AZ-104 &middot; NCA-AIIO</dd></div>
        <div><dt>lab</dt><dd>Proxmox &middot; Wazuh &middot; Tailscale</dd></div>
        <div><dt>focus</dt><dd>SOC analyst &middot; pentesting</dd></div>
        <div class="swatches" aria-hidden="true">
          <i style="background:#0a0a0f"></i><i style="background:#1e1e2e"></i><i
            style="background:#6a6a7a"></i><i style="background:#c8c8d0"></i><i
            style="background:#00b87d"></i><i style="background:#00e5a0"></i>
        </div>
      </dl>
    </div>

    <div class="cmd">cat bio.txt</div>
    <div class="prose">
      <p>
        I'm Diyor, an IT professional working my way into security. The homelab is my
        classroom: a Proxmox box running Wazuh, Tailscale, and whatever I'm studying this
        week. I break things there on purpose and write them down so the lessons stick.
      </p>
      <p>
        Days are IT support for thousands of users: endpoints, tickets, and real people.
        It teaches the human side of security no cert can. Nights are WGU for the B.S. in
        Cybersecurity and Information Assurance, on track for August 2028. The destination
        is a SOC analyst seat, with enough offensive skill to know what I'm defending
        against.
      </p>
    </div>

    <div class="cmd">cat now.txt</div>
    <div class="now">
      <div class="item">writing Wazuh detection rules for the homelab</div>
      <div class="item">Proxmox rebuild series — part 3 in progress</div>
      <span class="stamp">last updated 2026-07-10</span>
    </div>

    <div class="cmd">printenv CONTACT</div>
    <div class="connect">
      <a href="https://github.com/0xDiyor" target="_blank" rel="noopener noreferrer">github</a>
      <a href="https://www.linkedin.com/in/diyor-r/" target="_blank" rel="noopener noreferrer">linkedin</a>
      <a href="/rss.xml">rss</a>
    </div>
  </div>
</Base>

<style>
  /* Center the whole session block on a fixed character column rather than
     sizing it to its widest line — otherwise one long row (the certs list)
     widens the block and shifts every other line sideways with it.
     Text inside stays left-aligned so it reads like terminal output. */
  .about {
    width: min(100%, 62ch);
    margin: 0 auto;
  }

  .cmd {
    font-size: 0.8rem;
    color: var(--text-dim);
    margin: 2rem 0 0.9rem;
  }
  .cmd::before {
    content: '~$ ';
    color: var(--accent-dim);
  }
  .about > .cmd:first-child { margin-top: 0; }

  .fetch {
    display: flex;
    flex-wrap: wrap;
    column-gap: 2.5rem;
    row-gap: 1.5rem;
    align-items: center;
  }
  .logo {
    font-family: var(--mono);
    font-size: 0.8rem;
    line-height: 1.3;
    color: var(--accent);
    text-shadow: 0 0 20px rgba(0, 229, 160, 0.22);
    white-space: pre;
    flex-shrink: 0;
  }
  .logo .dm { color: var(--accent-dim); }
  .logo .xd { color: var(--text-dim); }
  .logo .cursor { animation: blink 1.2s step-end infinite; }

  .kv {
    font-size: 0.82rem;
    line-height: 2;
  }
  .kv div { display: flex; gap: 0; }
  .kv dt {
    color: var(--accent);
    width: 7ch;
    flex-shrink: 0;
  }
  .kv dt::after { content: ':'; color: var(--text-dim); }
  .kv dd { margin: 0; }
  .swatches { gap: 0.3rem; margin-top: 0.5rem; }
  .swatches i { width: 18px; height: 11px; display: inline-block; }

  .prose {
    font-size: 0.88rem;
    line-height: 1.8;
  }
  /* Blocks fill the centered column so every left and right edge lines up. */
  .prose p { margin-bottom: 1rem; }

  .now {
    border: 1px solid var(--border);
    background: var(--bg-surface);
    padding: 0.9rem 1.1rem;
    font-size: 0.82rem;
    line-height: 1.9;
  }
  .now .item::before {
    content: '▸ ';
    color: var(--accent);
  }
  .now .stamp {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.7rem;
    color: var(--text-dim);
  }

  .connect { font-size: 0.85rem; }
  .connect a {
    color: var(--text-dim);
    margin-right: 2.5ch;
    transition: color 0.15s;
  }
  .connect a::before {
    content: '> ';
    color: var(--accent-dim);
    font-weight: 700;
  }
  .connect a:hover { color: var(--accent); }

  @media (max-width: 600px) {
    /* Stacked on mobile: center the CRT logo and the facts card */
    .fetch { flex-direction: column; align-items: center; gap: 1.5rem; }
    .logo { font-size: 0.72rem; }
  }
</style>
