---
import Base from '../layouts/Base.astro';
import AsciiName from '../components/AsciiName.astro';
import Nav from '../components/Nav.astro';
import PostRecord from '../components/PostRecord.astro';
import ProjectRecord from '../components/ProjectRecord.astro';
import { getSortedPosts } from '../utils/posts';
import { sortedBounties } from '../data/bounties';
import { fetchAllProjects } from '../data/projects';

const posts = (await getSortedPosts()).slice(0, 3);
const bounties = sortedBounties().slice(0, 3);
const projects = (await fetchAllProjects()).slice(0, 3);
---

<Base home>
  <header class="hero">
    <h1 class="sr-only">0xDiyor</h1>
    <AsciiName size="lg" />
    <p class="dim">Denver · CySA+ · Security+ · Network+</p>
    <p>
      IT professional and cybersecurity student, working my way into security. I write about my
      homelab, security topics, and anything I find cool.
    </p>
    <Nav>
      <a href="https://github.com/0xDiyor" target="_blank" rel="noopener noreferrer">github</a>
      <a href="https://www.linkedin.com/in/diyor-r/" target="_blank" rel="noopener noreferrer"
        >linkedin</a
      >
    </Nav>
  </header>

  <section>
    <h2 class="label"><span>Writing</span><a href="/blog/">all posts</a></h2>
    {posts.map((post) => <PostRecord post={post} />)}
  </section>

  {
    bounties.length > 0 && (
      <section>
        <h2 class="label">
          <span>CVEs &amp; bounties</span>
          <a href="/cves/">all advisories</a>
        </h2>
        {bounties.map((b) => (
          <a class="record" href="/cves/">
            <span class="record-head">
              <span class="record-title">
                <span class={`sev sev-${b.severity.toLowerCase()}`}>{b.severity.toUpperCase()}</span>
                {b.cve ?? b.program}
              </span>
              <time datetime={b.date}>{b.date}</time>
            </span>
            <span class="record-desc">{b.title}</span>
          </a>
        ))}
      </section>
    )
  }

  <section>
    <h2 class="label"><span>Projects</span><a href="/projects/">all projects</a></h2>
    {projects.map((project) => <ProjectRecord project={project} aside="tech" />)}
  </section>
</Base>

<style>
  .hero {
    padding-top: 56px;
    margin-bottom: 48px;
  }
  .hero :global(.ascii-name) {
    margin-bottom: 12px;
  }
  .hero .dim {
    margin-bottom: 24px;
  }
</style>
