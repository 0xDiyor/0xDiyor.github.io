---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getSortedPosts, isoDate, readingTime } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      // Other parts of the same series, oldest first
      series: post.data.series
        ? posts.filter((p) => p.data.series === post.data.series).reverse()
        : [],
    },
  }));
}

const { post, series } = Astro.props;
const { Content, headings } = await render(post);
// Contents lists h2 headings only; the CSS numbers them to match the headings
const toc = headings.filter((h) => h.depth === 2);
const iso = isoDate(post.data.date);
const part = series.findIndex((p) => p.id === post.id) + 1;
---

<Base title={`${post.data.title} — 0xDiyor`} description={post.data.description}>
  <article>
    <h1 class="post-title">{post.data.title}</h1>
    <dl class="spec">
      <dt>date</dt>
      <dd><time datetime={iso}>{iso}</time></dd>
      <dt>read</dt>
      <dd>{readingTime(post)} min</dd>
      {
        post.data.tags.length > 0 && (
          <>
            <dt>tags</dt>
            <dd>{post.data.tags.join(' · ')}</dd>
          </>
        )
      }
      {
        series.length > 1 && (
          <>
            <dt>series</dt>
            <dd>
              {post.data.series}, part {part} of {series.length}
            </dd>
          </>
        )
      }
    </dl>

    {
      toc.length > 0 && (
        <nav class="toc" aria-label="Contents">
          <h2 class="label">
            <span>Contents</span>
          </h2>
          <ol>
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="prose">
      <Content />
    </div>
  </article>

  {
    series.length > 1 && (
      <section class="series">
        <h2 class="label">
          <span>Series</span>
          <span>{post.data.series}</span>
        </h2>
        {series.map((p, i) =>
          p.id === post.id ? null : (
            <a class="record" href={`/blog/${p.id}/`}>
              <span class="record-kicker">
                {i < part - 1 ? '← ' : ''}part {i + 1}
                {i > part - 1 ? ' →' : ''}
              </span>
              <span class="record-title">{p.data.title}</span>
            </a>
          )
        )}
      </section>
    )
  }

  <p class="dim back">&larr; <a href="/blog/">all posts</a></p>
</Base>

<style>
  .series {
    margin-top: 48px;
  }
  .back {
    margin-top: 40px;
  }
</style>
