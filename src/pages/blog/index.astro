---
import Base from '../../layouts/Base.astro';
import PostRecord from '../../components/PostRecord.astro';
import { getSortedPosts, type Post } from '../../utils/posts';

const posts = await getSortedPosts();

// Group by year so each record only needs month and day
const years = new Map<number, Post[]>();
for (const post of posts) {
  const y = post.data.date.getUTCFullYear();
  years.set(y, [...(years.get(y) ?? []), post]);
}
const plural = (n: number) => `${n} post${n === 1 ? '' : 's'}`;
---

<Base title="0xDiyor — Blog">
  <h1 class="page-title">blog</h1>
  {
    [...years].map(([year, list]) => (
      <section>
        <h2 class="label">
          <span>{year}</span>
          <span>{plural(list.length)}</span>
        </h2>
        {list.map((post) => <PostRecord post={post} short />)}
      </section>
    ))
  }
</Base>

<style>
  /* No subtitle here, so give the title the space the subtitle would have */
  .page-title {
    margin-bottom: 36px;
  }
</style>
