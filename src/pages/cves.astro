---
import Base from '../layouts/Base.astro';
import { sortedBounties } from '../data/bounties';

const bounties = sortedBounties();
const isExternal = (url: string) => url.startsWith('http');
---

<Base title="0xDiyor — CVEs & Bounties">
  <h1 class="page-title">cves &amp; bounties</h1>

  {
    bounties.length === 0 ? (
      <p class="dim">No advisories published yet.</p>
    ) : (
      <ul class="rows">
        {bounties.map((b) => (
          <li>
            <time datetime={b.date}>{b.date}</time>
            <span>
              {b.programUrl ? (
                <a href={b.programUrl} target="_blank" rel="noopener noreferrer">
                  {b.program}
                </a>
              ) : (
                b.program
              )}
              {' · '}
              {b.title}
              <span class="sub">
                {[b.cve, b.severity, ...b.type].filter(Boolean).join(' · ')}
                {b.bounty != null && ` · $${b.bounty.toLocaleString('en-US')}`}
                {b.links.map((link) => (
                  <>
                    {' · '}
                    <a
                      href={link.url}
                      {...(isExternal(link.url) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                    >
                      {link.label}
                    </a>
                  </>
                ))}
              </span>
            </span>
          </li>
        ))}
      </ul>
    )
  }
</Base>
