---
import Base from '../layouts/Base.astro';
import { fetchAllProjects } from '../data/projects';

const projects = await fetchAllProjects();
---

<Base title="0xDiyor — Projects">
  <h1 class="page-title">projects</h1>
  <div>
    {
      projects.map((p) => (
        <div class="project">
          <div class="project-head">
            <a class="ext" href={p.github || p.demo || '#'} target="_blank" rel="noopener noreferrer">
              {p.name}
            </a>
            <time datetime={p.date}>{p.date.slice(0, 7)}</time>
          </div>
          {p.description && <p>{p.description}</p>}
          {p.tech.length > 0 && <span class="dim">{p.tech.join(' · ')}</span>}
        </div>
      ))
    }
  </div>
</Base>
