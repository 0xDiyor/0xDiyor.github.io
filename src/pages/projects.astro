---
import Base from '../layouts/Base.astro';
import ProjectRecord from '../components/ProjectRecord.astro';
import { fetchAllProjects, type Project } from '../data/projects';

const projects = await fetchAllProjects();

// Group under each project's category. Listed categories come first in this
// order; any others follow by newest project, with uncategorized last.
const ORDER = ['Tools', 'Sites & coursework'];
const groups = new Map<string, Project[]>(ORDER.map((c) => [c, []]));
for (const p of projects) {
  const key = p.category ?? 'Other';
  groups.set(key, [...(groups.get(key) ?? []), p]);
}
const other = groups.get('Other');
if (other) {
  groups.delete('Other');
  groups.set('Other', other);
}
const sections = [...groups].filter(([, list]) => list.length > 0);
---

<Base title="0xDiyor — Projects">
  <h1 class="page-title">projects</h1>
  <p class="page-sub">Things I've built and am working on.</p>
  {
    sections.map(([name, list]) => (
      <section>
        <h2 class="label">
          <span>{name}</span>
        </h2>
        {list.map((project) => <ProjectRecord project={project} />)}
      </section>
    ))
  }
</Base>
