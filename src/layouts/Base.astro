---
import '../styles/global.css';
import AsciiName from '../components/AsciiName.astro';
import Nav from '../components/Nav.astro';
import Social from '../components/Social.astro';

interface Props {
  title?: string;
  description?: string;
  // The home page draws its own large name and nav, so it skips the header
  home?: boolean;
}

const {
  title = '0xDiyor',
  description = 'Portfolio and blog covering cybersecurity projects, hands-on writeups, and CVE and bug bounty research.',
  home = false,
} = Astro.props;

const path = Astro.url.pathname;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:site_name" content="0xDiyor" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(path, Astro.site)} />
    <!-- Link preview card for Slack, iMessage, LinkedIn, X, Discord -->
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="0xDiyor in ASCII characters on black, with certs and site sections" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="0xDiyor" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    {
      !home && (
        <header class="bar">
          <a href="/" class="brand" aria-label="0xDiyor home">
            <AsciiName size="sm" />
          </a>
          <Nav />
        </header>
      )
    }

    <main>
      <slot />
    </main>

    <footer>
      <span>&copy; {new Date().getFullYear()} 0xDiyor</span>
      <a href="/rss.xml">rss</a>
      <Social labels />
    </footer>
  </body>
</html>
